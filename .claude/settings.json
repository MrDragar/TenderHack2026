{
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Read(.env)",
      "Edit(.env)",
      "Read(data/eval/test/**)",
      "Edit(data/eval/**)",
      "Edit(scripts/judge.py)",
      "Edit(scripts/generate.py)"
    ],
    "ask": [
      "Bash(docker *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(rm *)"
    ],
    "allow": [
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(pytest *)",
      "Bash(uv sync)",
      "Bash(uv lock)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  }
}
